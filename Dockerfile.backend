# ==============================================================================
# Dockerfile.backend — Production Flask API Container for SignBridge
# ==============================================================================

FROM python:3.11-slim

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT=5000
ENV HOST=0.0.0.0

# Install OpenCV and system dependencies required for MediaPipe & NumPy
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 appuser

WORKDIR /app

# Copy requirements and install dependencies
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application source code
COPY backend/ ./backend/

WORKDIR /app/backend

# Initialize directories requiring write permissions and grant ownership to appuser
RUN mkdir -p database models dataset_collected && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 5000 5001

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5000/api/health || exit 1

# Start Flask via Waitress WSGI production server with threads
CMD ["waitress-serve", "--listen=0.0.0.0:5000", "--threads=4", "app:app"]
