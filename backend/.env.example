# Sign-Bridge Environment Variables & API Keys Example
# Copy this file to .env and fill in your API keys:
# cp .env.example .env

# Groq LPU API Key (Sub-100ms Inference)
GROQ_API_KEY=your_groq_api_key_here

# Google Generative AI / Gemini API Keys (Dual Key Auto-Rotation & Fallback)
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini Manager Configuration
GEMINI_MAX_RETRIES=3
GEMINI_MAX_MODEL_FALLBACKS=4
GEMINI_TIMEOUT=30

PORT=5000
HOST=0.0.0.0

